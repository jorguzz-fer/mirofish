# ===========================================
# MiroFish VPS .env  (copy to .env on the server)
# ===========================================
# Provider: OpenAI-compatible cheap endpoint (DeepSeek / Groq / OpenRouter / Qwen).
# The backend uses the OpenAI SDK for any non-Anthropic / non-CLI provider,
# so just point LLM_BASE_URL at your provider and set the model name.

LLM_PROVIDER=openai

# ----- Pick ONE provider block below -----

# DeepSeek (cheap, strong general model)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat
LLM_API_KEY=sk-your-deepseek-key

# Groq (free tier, very fast)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL_NAME=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_your-groq-key

# OpenRouter (one key, many models)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL_NAME=deepseek/deepseek-chat
# LLM_API_KEY=sk-or-your-key

# Alibaba Qwen (OpenAI-compatible mode)
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_NAME=qwen-plus
# LLM_API_KEY=sk-your-qwen-key

# ===== Server runtime =====
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5001

# Keep early simulations small — they consume a LOT of tokens.
OASIS_DEFAULT_MAX_ROUNDS=5

# KuzuDB lives under backend/data (persisted via the compose volume).
